<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="[7.2.0]" />
    <PackageReference Include="JustMyPackages.Styles" Version="1.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.33" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="WireMock.Net" Version="2.21.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\hosting\JustMyPackages.Logging\JustMyPackages.Logging.csproj" />
    <ProjectReference Include="..\..\http-rpc\JustMyPackages.Http.Rpc.Client\JustMyPackages.Http.Rpc.Client.csproj" />
    <ProjectReference Include="..\..\serialization\messagepack\JustMyPackages.Http.Rpc.Serialization.MessagePack\JustMyPackages.Http.Rpc.Serialization.MessagePack.csproj" />
    <ProjectReference Include="..\..\serialization\newtonsoft\JustMyPackages.Http.Rpc.Serialization.NewtonsoftJson\JustMyPackages.Http.Rpc.Serialization.NewtonsoftJson.csproj" />
    <ProjectReference Include="..\..\serialization\textjson\JustMyPackages.Http.Rpc.Serialization.TextJson\JustMyPackages.Http.Rpc.Serialization.TextJson.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
