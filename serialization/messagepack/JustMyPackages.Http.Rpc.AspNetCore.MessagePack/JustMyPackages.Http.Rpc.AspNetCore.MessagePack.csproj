  <Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Authors>Roman Vovk</Authors>
    <Description>Package with MessagePack serialization MVC extension applying my default settings.</Description>
    <PackageProjectUrl>https://github.com/wolf8196/JustMyPackages</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wolf8196/JustMyPackages</RepositoryUrl>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JustMyPackages.Styles" Version="1.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MessagePack.AspNetCoreMvcFormatter" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JustMyPackages.Serialization.MessagePack\JustMyPackages.Serialization.MessagePack.csproj" />
  </ItemGroup>

</Project>